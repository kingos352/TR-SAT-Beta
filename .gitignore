# ── Dependencies ───────────────────────────────────────────────
node_modules/
**/node_modules/
.venv/
**/.venv/

# ── Python ─────────────────────────────────────────────────────
__pycache__/
**/__pycache__/
*.pyc
.pytest_cache/
**/.pytest_cache/

# ── Build outputs ──────────────────────────────────────────────
dist/
**/dist/
build/
**/build/
src-tauri/target/

# ── Databases & runtime data ───────────────────────────────────
data/
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.db

# ── Secrets & local env (DO NOT COMMIT) ────────────────────────
.env
.env.*
!.env.example

# ── Installer build artifacts ─────────────────────────────────
installer/assets/*.bmp
installer/assets/icon.ico
installer/output/
installer/redist/MicrosoftEdgeWebview2Setup.exe
backend/build/
backend/dist/

# ── Python virtual environments ────────────────────────────────
.venv-build/
**/.venv-build/

# ── Large ephemeris data files ──────────────────────────────────
*.bsp

# ── Installer binaries ─────────────────────────────────────────
installer/*.exe

# ── Batch scripts ──────────────────────────────────────────────
*.bat

# ── Editor / OS ────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.log
.idea/
.vscode/
